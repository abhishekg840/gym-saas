# Copy to .env.local and fill in. NEVER commit .env.local (see .gitignore).

# --- Supabase (required) ------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Gate pass signing (required in production) -------------------------------
# Signs the rotating gate-pass token with HMAC-SHA256. /api/member/pass/mint
# FAILS CLOSED without this in production (503), which makes every member's
# Gate Pass show "Pass Unavailable" even when their membership is active.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Optional integrations ----------------------------------------------------
# CRON_SECRET=            # protects /api/cron/* if set; open in dev otherwise
# AI_API_KEY=             # or OPENAI_API_KEY
# AI_BASE_URL=
# AI_MODEL=
# WHATSAPP_GATEWAY_URL=

# --- Cashfree (platform B2B subscription billing) -----------------------------
# Gym owners pay Vyroniq (Starter ₹799/mo, Pro ₹1,499/mo) through Cashfree.
# Without these, /api/super-admin/billing/create-order returns 503 and the
# /api/webhooks/cashfree handler refuses every event (it cannot verify a
# signature it has no secret for) — failing closed, so an unconfigured deploy
# can never activate a subscription it did not actually collect money for.
# App ID + Secret Key come from the Cashfree Merchant Dashboard.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# SANDBOX (default) or PRODUCTION. Leave SANDBOX until the live keys are set.
CASHFREE_ENV=SANDBOX
